_model":1}},{"id":32,"type":"QwenImage21Cache","pos":[2307.3955430319693,363.3769514868851],"size":[420,130],"flags":{},"order":16,"mode":0,"inputs":[{"localized_name":"model","name":"model","type":"MODEL","link":2},{"localized_name":"device","name":"device","type":"COMBO","widget":{"name":"device"},"link":null},{"localized_name":"dtype","name":"dtype","type":"COMBO","widget":{"name":"dtype"},"link":null}],"outputs":[{"localized_name":"模型","name":"MODEL","type":"MODEL","slot_index":0,"links":[3,4]}],"properties":{"cnr_id":"comfy-core","ver":"0.43.0","Node name for S&R":"QwenImage21Cache"},"widgets_values":["auto","default"],"widgets_values_named":{"device":"auto","dtype":"default"}},{"id":33,"type":"CLIPLoader","pos":[2307.3955430319693,533.376951486885],"size":[420,130],"flags":{},"order":8,"mode":0,"inputs":[{"localized_name":"CLIP名称","name":"clip_name","type":"COMBO","widget":{"name":"clip_name"},"link":null},{"localized_name":"类型","name":"type","type":"COMBO","widget":{"name":"type"},"link":null},{"localized_name":"设备","name":"device","shape":7,"type":"COMBO","widget":{"name":"device"},"link":null}],"outputs":[{"localized_name":"CLIP","name":"CLIP","type":"CLIP","slot_index":0,"links":[5,6]}],"properties":{"cnr_id":"comfy-core","ver":"0.43.0","Node name for S&R":"CLIPLoader"},"widgets_values":["qwen3vl_8b_int8_convrot.safetensors","qwen_image","default"],"widgets_values_named":{"clip_name":"qwen3vl_8b_int8_convrot.safetensors","type":"qwen_image","device":"default"}},{"id":34,"type":"VAELoader","pos":[2307.3955430319693,703.376951486885],"size":[420,82],"flags":{},"order":9,"mode":0,"inputs":[{"localized_name":"vae名称","name":"vae_name","type":"COMBO","widget":{"name":"vae_name"},"link":null}],"outputs":[{"localized_name":"VAE","name":"VAE","type":"VAE","slot_index":0,"links":[7,8,9,10]}],"properties":{"cnr_id":"comfy-core","ver":"0.43.0","Node name for S&R":"VAELoader"},"widgets_values":["qwen_image_2.1_vae_bf16.safetensors"],"widgets_values_named":{"vae_name":"qwen_image_2.1_vae_bf16.safetensors"}},{"id":100,"type":"MarkdownNote","pos":[40,2960],"size":[1700,650],"flags":{},"order":10,"mode":0,"inputs":[],"outputs":[],"title":"使用说明 · 快速上手","properties":{"Node name for S&R":"MarkdownNote"},"widgets_values":["# 四库出图 · Qwen Image 2.1\n\n发型、脸、服装、姿势四张参考图合成一张人像。画布顶部「示例开关」点哪组跑哪组，另一组自动静音。\n\n## 两种用法\n| 分组 | 操作 | 适合 |\n| --- | --- | --- |\n| ① 单独节点（左上） | 发型 / 脸 / 服装 / 姿势四个节点各点一次 | 逐张换、逐张对比 |\n| ② 四合一配方（左下） | `CharacterRecipe` 一个节点四行点完 | 常规出图，提示词自动拼 |\n\n开关单选，状态随工作流存盘；也可框选一组按 `Ctrl+M` 手动静音。\n\n## 四张参考顺序固定，不能交换\n| 端口 / 输出 | 来源 | 提供 |\n| --- | --- | --- |\n| `image_1` / `pose_image` | 姿势 | 动作、朝向、构图 |\n| `image_2` / `face_image` | 脸 | 身份、五官、肤色 |\n| `image_3` / `costume_image` | 服装 | 衣服、配饰、颜色 |\n| `image_4` / `hair_image` | 发型 | 长短、刘海、分缝、发色 |\n\n发型与脸冲突时以 `image_4` 为准。\n\n## 上手步骤\n1. 点图库节点的「浏览…图库」，按中文 / 编号 / 关键词搜，选中点「使用此素材」；也可在任意「加载图像」节点点「从参考图库导入」。\n2. `hair_source` 选发型来源：澪设计（带描述）或二次元（仅关键词）；换来源后编号自动回落。\n3. 顶部开关选 ① 或 ②，点运行。\n\n## 用自己的照片当脸\n照片放进左上空的 `Load Image`，把编码器 `image_2` 上来自 `Face Gallery` 的线拖过去，其余不动。\n\n## 必要前提\n- 只依赖本插件 + ComfyUI 内置节点；四个模型文件按 `ref_gallery_qwen21.md` 放好，重启 ComfyUI。\n- LoRA `VNCCS_QI2_PoseStudioV2` 放 `models/loras/` 根目录，不要建子目录。\n- 升级后先刷新页面再用开关。\n\n## 参数与提示词\n25 步 / CFG 1 / euler / simple，种子固定，LoRA 强度 1。配方 `resize_mode` 默认 896×1152 居中裁剪；单独节点用「原图尺寸」，比例跟随 `image_1`。提示词在编码器里直接改；配方接 `prompt_zh`（默认）、`prompt_en`（英文）或断开手写。\n\n## 输出\n`output/ref_gallery/single/result`（①）｜ `output/ref_gallery/recipe/result`（②）｜ `output/ref_gallery/recipe/reference_sheet`（四合一参考整图）\n"],"widgets_values_named":{"text":"# 四库出图 · Qwen Image 2.1\n\n发型、脸、服装、姿势四张参考图合成一张人像。画布顶部「示例开关」点哪组跑哪组，另一组自动静音。\n\n## 两种用法\n| 分组 | 操作 | 适合 |\n| --- | --- | --- |\n| ① 单独节点（左上） | 发型 / 脸 / 服装 / 姿势四个节点各点一次 | 逐张换、逐张对比 |\n| ② 四合一配方（左下） | `CharacterRecipe` 一个节点四行点完 | 常规出图，提示词自动拼 |\n\n开关单选，状态随工作流存盘；也可框选一组按 `Ctrl+M` 手动静音。\n\n## 四张参考顺序固定，不能交换\n| 端口 / 输出 | 来源 | 提供 |\n| --- | --- | --- |\n| `image_1` / `pose_image` | 姿势 | 动作、朝向、构图 |\n| `image_2` / `face_image` | 脸 | 身份、五官、肤色 |\n| `image_3` / `costume_image` | 服装 | 衣服、配饰、颜色 |\n| `image_4` / `hair_image` | 发型 | 长短、刘海、分缝、发色 |\n\n发型与脸冲突时以 `image_4` 为准。\n\n## 上手步骤\n1. 点图库节点的「浏览…图库」，按中文 / 编号 / 关键词搜，选中点「使用此素材」；也可在任意「加载图像」节点点「从参考图库导入」。\n2. `hair_source` 选发型来源：澪设计（带描述）或二次元（仅关键词）；换来源后编号自动回落。\n3. 顶部开关选 ① 或 ②，点运行。\n\n## 用自己的照片当脸\n照片放进左上空的 `Load Image`，把编码器 `image_2` 上来自 `Face Gallery` 的线拖过去，其余不动。\n\n## 必要前提\n- 只依赖本插件 + ComfyUI 内置节点；四个模型文件按 `ref_gallery_qwen21.md` 放好，重启 ComfyUI。\n- LoRA `VNCCS_QI2_PoseStudioV2` 放 `models/loras/` 根目录，不要建子目录。\n- 升级后先刷新页面再用开关。\n\n## 参数与提示词\n25 步 / CFG 1 / euler / simple，种子固定，LoRA 强度 1。配方 `resize_mode` 默认 896×1152 居中裁剪；单独节点用「原图尺寸」，比例跟随 `image_1`。提示词在编码器里直接改；配方接 `prompt_zh`（默认）、`prompt_en`（英文）或断开手写。\n\n## 输出\n`output/ref_gallery/single/result`（①）｜ `output/ref_gallery/recipe/result`（②）｜ `output/ref_gallery/recipe/reference_sheet`（四合一参考整图）\n"},"color":"#432","bgcolor":"#653"},{"id":40,"type":"PromptJoin","pos":[1114.4893327861214,787.7201764113266],"size":[620,560],"flags":{},"order":11,"mode":0,"inputs":[{"localized_name":"extra","name":"extra","shape":7,"type":"STRING","link":32},{"localized_name":"extra2","name":"extra2","shape":7,"type":"STRING","link":null},{"localized_name":"text","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs":[{"localized_name":"prompt","name":"prompt","type":"STRING","slot_index":0,"links":[31]}],"title":"Prompt Join 提示词拼接 - 中文分工说明 + 所选发型的描述","properties":{"Node name for S&R":"PromptJoin"},"widgets_values":["四张参考图合成一张完整的人物照片，每张图只负责一件事：\n\n【图1 · 姿势与构图】照它的肢体位置、身体朝向、机位与取景，动作不要改。\n【图2 · 脸与身份】只取长相：五官、脸型、肤色、气质，把这张脸接在自然完整的身体上。图2 自带的头发一律不要——长发、刘海、卷度全部丢掉。\n【图3 · 服装】把里面这套衣服与配饰穿到人物身上，颜色、图案、材质、叠穿、细节都照它。\n【图4 · 头发】图4 是发型（假发）参考，只取头发：长度、层次、发尾走向、发色、刘海、分缝全部照它，把人物头顶的头发整体换掉。图4 里的白色人台、脖子、底座、纯色背景都不要画进来。\n头发的铁律：只认图4。图4 与图2 冲突时一律以图4 为准；哪怕要改人物轮廓，也不能保留图2 原来的头发。\n\n只输出一个人物的单张照片：图1 的姿态、图2 的脸、图3 的衣服、图4 的头发。衣服贴合姿态，褶皱与遮挡自然，头颈肩结构连贯。不要照搬参考图里的灰色人偶、线稿、纯色背景和标注文字，不要输出拼图或参考图合集。"],"widgets_values_named":{"text":"四张参考图合成一张完整的人物照片，每张图只负责一件事：\n\n【图1 · 姿势与构图】照它的肢体位置、身体朝向、机位与取景，动作不要改。\n【图2 · 脸与身份】只取长相：五官、脸型、肤色、气质，把这张脸接在自然完整的身体上。图2 自带的头发一律不要——长发、刘海、卷度全部丢掉。\n【图3 · 服装】把里面这套衣服与配饰穿到人物身上，颜色、图案、材质、叠穿、细节都照它。\n【图4 · 头发】图4 是发型（假发）参考，只取头发：长度、层次、发尾走向、发色、刘海、分缝全部照它，把人物头顶的头发整体换掉。图4 里的白色人台、脖子、底座、纯色背景都不要画进来。\n头发的铁律：只认图4。图4 与图2 冲突时一律以图4 为准；哪怕要改人物轮廓，也不能保留图2 原来的头发。\n\n只输出一个人物的单张照片：图1 的姿态、图2 的脸、图3 的衣服、图4 的头发。衣服贴合姿态，褶皱与遮挡自然，头颈肩结构连贯。不要照搬参考图里的灰色人偶、线稿、纯色背景和标注文字，不要输出拼图或参考图合集。"}}],"links":[[1,30,0,31,0,"MODEL"],[2,31,0,32,0,"MODEL"],[3,32,0,6,0,"MODEL"],[4,32,0,22,0,"MODEL"],[8,34,0,7,1,"VAE"],[10,34,0,23,1,"VAE"],[15,5,0,6,1,"CONDITIONING"],[16,5,1,6,2,"CONDITIONING"],[17,5,2,6,3,"LATENT"],[18,6,0,7,0,"LATENT"],[19,7,0,8,0,"IMAGE"],[25,21,0,22,1,"CONDITIONING"],[26,21,1,22,2,"CONDITIONING"],[27,21,2,22,3,"LATENT"],[28,22,0,23,0,"LATENT"],[29,23,0,24,0,"IMAGE"],[30,20,3,25,0,"IMAGE"],[32,1,7,40,0,"STRING"],[5,33,0,5,0,"CLIP"],[11,4,0,5,1,"IMAGE"],[12,2,0,5,2,"IMAGE"],[13,3,0,5,3,"IMAGE"],[14,1,0,5,4,"IMAGE"],[7,34,0,5,6,"VAE"],[31,40,0,5,7,"STRING"],[6,33,0,21,0,"CLIP"],[20,20,2,21,1,"IMAGE"],[21,20,0,21,2,"IMAGE"],[22,20,1,21,3,"IMAGE"],[23,20,8,21,4,"IMAGE"],[9,34,0,21,6,"VAE"],[24,20,6,21,7,"STRING"]],"groups":[{"id":1,"title":"① 单独节点：发型 / 脸部 / 服装 / 姿势 各取一张 → 一次出图","bounding":[0,0,2220,1420],"color":"#3f789e","flags":{}},{"id":2,"title":"② 四合一配方：一个节点取齐四样，提示词自动拼好","bounding":[0,1540,2300,1380],"color":"#8a6d3b","flags":{}},{"id":3,"title":"③ 模型与采样（两条链共用）","bounding":[2247.3955430319693,3.3769514868850994,520,820],"color":"#5a5a5a","flags":{}}],"config":{},"extra":{"workflowName":"参考图库 · 四库出图（单独节点 / 四合一配方）","ds":{"scale":0.6514751569704322,"offset":[318.6435363704154,306.7646665540832]}},"version":0.4}